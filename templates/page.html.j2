<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta http-equiv="Content-Security-Policy" content="{{ csp|safe }}">
<meta name="referrer" content="strict-origin-when-cross-origin">
<title>{{ d.lead.headline }} | Utica Midstream</title>
<meta name="description" content="{{ desc }}">
<meta name="robots" content="index, follow, max-image-preview:large">
<link rel="canonical" href="{{ url }}">
{% if cfg.google_site_verification %}<meta name="google-site-verification" content="{{ cfg.google_site_verification }}">{% endif %}
{% if cfg.bing_site_verification %}<meta name="msvalidate.01" content="{{ cfg.bing_site_verification }}">{% endif %}
<meta name="theme-color" content="#13263A">
<meta property="og:type" content="article">
<meta property="og:site_name" content="Utica Midstream">
<meta property="og:title" content="{{ d.lead.headline }}">
<meta property="og:description" content="{{ desc }}">
<meta property="og:url" content="{{ url }}">
<meta property="og:image" content="https://uticamidstream.com/social/{{ d.date }}.png">
<meta property="og:image:width" content="1080"><meta property="og:image:height" content="1350">
<meta property="article:published_time" content="{{ published }}">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ d.lead.headline }}">
<meta name="twitter:description" content="{{ desc }}">
<meta name="twitter:image" content="https://uticamidstream.com/social/{{ d.date }}.png">
<link rel="icon" type="image/svg+xml" href="{{ root }}brand/um-icon.svg">
<link rel="apple-touch-icon" href="{{ root }}brand/um-icon-180.png">
<link rel="alternate" type="application/rss+xml" title="Utica Midstream" href="{{ root }}feed.xml">
<link rel="preload" href="{{ root }}assets/fonts/barlow-semi-condensed-latin-700-normal.woff2" as="font" type="font/woff2" crossorigin>
<link rel="stylesheet" href="{{ root }}assets/style.css?v={{ v }}">
{% if cfg.ga_id %}<script async src="https://www.googletagmanager.com/gtag/js?id={{ cfg.ga_id }}"></script><script src="{{ root }}assets/ga.js?v={{ v }}" data-id="{{ cfg.ga_id }}"></script>{% endif %}
<script type="application/ld+json">{{ ld|safe }}</script>
</head>
<body>
{% include "header.html.j2" %}
<div class="tape" id="prices-tape" aria-label="Price tape">
 <div class="wrap tape-in">{% for r in d.prices.rows %}<span class="tk"><b>{{ r.name }}</b> <span class="num">{{ r.value }}</span>{% if r.pct %} <span class="num {{ 'dn' if r.pct.startswith('-') else 'up' }}">{{ r.pct }}</span>{% endif %}</span>{% endfor %}</div>
</div>
<main id="main">
<section class="lead">
 <div class="wrap">
  <p class="dateline">{{ d.date_long }}<span>Edition {{ d.edition }}</span>{% if archived %}<a href="{{ root }}">Today's edition</a>{% endif %}</p>
  <div class="lead-grid">
   <article class="lead-story">
    <p class="kick">{{ d.lead.kicker }}</p>
    <h1>{{ d.lead.headline }}</h1>
    <p class="dek">{{ d.lead.dek }}</p>
    {% for p in d.lead.body %}<p>{{ p }}</p>{% endfor %}
    <p class="src">Sources: {% for s in d.lead.sources %}<a href="{{ s.url }}" rel="noopener">{{ s.name }}</a>{% if not loop.last %}; {% endif %}{% endfor %}</p>
   </article>
   <aside class="flowline" aria-label="How this story moves along the value chain">
    <h2>Along the chain</h2>
    <ol>
     {% for seg, label in [("upstream","Upstream"),("midstream","Midstream"),("downstream","Downstream"),("market","Market")] %}
     <li class="st st-{{ seg }}{{ ' on' if seg in d.lead.chain else '' }}"><span class="node" aria-hidden="true"></span><h3>{{ label }}</h3><p>{{ d.lead.flow[seg] }}</p></li>
     {% endfor %}
    </ol>
   </aside>
  </div>
  <div class="use">
   <h2>Use it</h2>
   <dl>{% for u in d.lead.use %}<div><dt>{{ u.who }}</dt><dd>{{ u.text }}</dd></div>{% endfor %}</dl>
  </div>
 </div>
</section>

<section class="board" id="prices" aria-label="Commodity prices">
 <div class="wrap">
  <div class="board-head"><h2 class="sh">The board</h2><p class="asof">{{ d.prices.asof }}</p></div>
  <div class="board-grid">
   {% for g in ["Crude","Gas","Products"] %}
   <div class="panel">
    <h3>{{ g }}</h3>
    <table>
     <thead><tr><th scope="col">Benchmark</th><th scope="col" class="r">Last</th><th scope="col" class="r">Chg</th></tr></thead>
     <tbody>{% for r in d.prices.rows if r.group == g %}<tr><th scope="row"><a href="{{ r.source.url }}" rel="noopener">{{ r.name }}</a><span class="unit">{{ r.unit }}{% if r.note %} · {{ r.note }}{% endif %}</span></th><td class="r num">{{ r.value }}</td><td class="r num {{ 'dn' if r.pct.startswith('-') else 'up' }}">{{ r.change }}{% if r.change %}<br>{% endif %}<span class="pc">{{ r.pct }}</span></td></tr>{% endfor %}</tbody>
    </table>
   </div>
   {% endfor %}
  </div>
  <div class="spreads">
   <h3>Spreads that matter in the middle</h3>
   <ul>{% for s in d.prices.spreads %}<li><span class="num">{{ s.value }}</span><b>{{ s.name }}</b><span>{{ s.note }}</span></li>{% endfor %}</ul>
  </div>
 </div>
</section>

<section class="markets" id="markets" aria-label="Markets and stocks">
 <div class="wrap mk-grid">
  <div>
   <h2 class="sh">Markets</h2>
   <p class="asof">{{ d.markets.asof }}</p>
   <table class="idx">
    <tbody>{% for i in d.markets.indexes %}<tr><th scope="row">{{ i.name }}</th><td class="r num">{{ i.value }}</td><td class="r num {{ 'dn' if i.pct.startswith('-') else 'up' }}">{{ i.pct }}</td></tr>{% endfor %}</tbody>
   </table>
   <p class="src">Source: <a href="{{ d.markets.index_source.url }}" rel="noopener">{{ d.markets.index_source.name }}</a></p>
   <p class="read">{{ d.markets.read }} <a href="{{ d.markets.read_source.url }}" rel="noopener">{{ d.markets.read_source.name }}</a></p>
  </div>
  <div>
   <h2 class="sh">Stocks in the news</h2>
   <ul class="stocks">{% for s in d.markets.stocks %}<li><span class="tick">{{ s.ticker }}</span><div><p class="sn"><b>{{ s.name }}</b> <span class="seg">{{ s.segment }}</span>{% if s.price %} <span class="num">{{ s.price }}</span> <span class="num {{ 'dn' if s.pct.startswith('-') else 'up' }}">{{ s.pct }}</span>{% endif %}</p><p>{{ s.note }} <a href="{{ s.source.url }}" rel="noopener">{{ s.source.name }}</a></p></div></li>{% endfor %}</ul>
  </div>
 </div>
</section>

<section class="chain" id="chain">
 <div class="wrap">
  <h2 class="sh">Across the chain</h2>
  {% for b in d.briefs %}
  <article class="brief" id="{{ b.id }}">
   <div class="tags"><p class="seg seg-{{ b.segment|lower|replace(' ','-')|replace('-and-','-') }}">{{ b.segment }}</p><p class="set"><span>{{ b.setting }}</span><span>{{ b.region }}</span></p></div>
   <div>
    <h3>{{ b.headline }}</h3>
    <div class="brief-body"><p>{{ b.text }}</p><p class="why"><b>Why it matters.</b> {{ b.why }}</p></div>
    <p class="src">Sources: {% for s in b.sources %}<a href="{{ s.url }}" rel="noopener">{{ s.name }}</a>{% if not loop.last %}; {% endif %}{% endfor %}</p>
   </div>
  </article>
  {% endfor %}
 </div>
</section>

<section class="docket" id="docket">
 <div class="wrap">
  <h2 class="sh">The docket</h2>
  <p class="intro">Regulatory, government and producer group decisions that move money. Status is as reported by the agency or its filings.</p>
  <div class="dk-wrap"><table>
   <thead><tr><th scope="col">Date</th><th scope="col">Who</th><th scope="col">Action</th><th scope="col">Status</th><th scope="col">What it means</th></tr></thead>
   <tbody>{% for k in d.docket %}<tr><td class="num nowrap" data-l="Date">{{ k.date }}</td><td data-l="Who"><b>{{ k.agency }}</b></td><td data-l="Action">{{ k.action }} <a href="{{ k.source.url }}" rel="noopener">{{ k.source.name }}</a></td><td data-l="Status">{{ k.status }}</td><td data-l="What it means">{{ k.means }}</td></tr>{% endfor %}</tbody>
  </table></div>
 </div>
</section>

<section class="basins">
 <div class="wrap">
  <h2 class="sh">Basin and route watch</h2>
  <div class="bgrid">{% for b in d.basins %}<div class="bas"><p class="set">{{ b.setting }}</p><h3>{{ b.name }}</h3><p>{{ b.line }} <a href="{{ b.source.url }}" rel="noopener">{{ b.source.name }}</a></p></div>{% endfor %}</div>
 </div>
</section>

<section class="two">
 <div class="wrap two-grid">
  <div class="leader" id="leader">
   <p class="kick">Leader of the week · {{ d.leader.week_of }}</p>
   <div class="lh"><span class="mono" aria-hidden="true">{{ d.leader.name.split()|map('first')|join }}</span><div><h2>{{ d.leader.name }}</h2><p class="role">{{ d.leader.role }}</p></div></div>
   <p>{{ d.leader.summary }}</p>
   <p>{{ d.leader.path }}</p>
   <p class="why"><b>Why we are watching.</b> {{ d.leader.why }}</p>
   <p class="src">Sources: {% for s in d.leader.sources %}<a href="{{ s.url }}" rel="noopener">{{ s.name }}</a>{% if not loop.last %}; {% endif %}{% endfor %}</p>
  </div>
  <div class="events" id="events">
   <h2 class="sh">On the calendar</h2>
   <ul class="cal">{% for e in d.events %}<li><span class="when num">{{ e.when }}</span><div><a href="{{ e.url }}" rel="noopener"><b>{{ e.name }}</b></a><span>{{ e.where }}. {{ e.note }}.</span></div></li>{% endfor %}</ul>
   <p class="src">Confirm dates with each organizer before booking travel.</p>
  </div>
 </div>
</section>
</main>
{% include "footer.html.j2" %}
</body>
</html>
